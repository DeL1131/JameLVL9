MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1678319895}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1453cc91dd7297243854e29373f09575, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  message: "[E] \u041D\u0430\u0447\u0430\u0442\u044C"
  interactKey: 101
  _audioSource: {fileID: 0}
  _gameFlowManager: {fileID: 590671668}
  _bossSummonedMessage: "\u041A\u0442\u043E \u043F\u043E\u0441\u043C\u0435\u043B
    \u043C\u0435\u043D\u044F \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C? \u0416\u0430\u043B\u043A\u0438\u0439
    \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0439!"
  _startFightMessage: "E - \u041D\u0430\u0447\u0430\u0442\u044C \u0421\u0440\u0430\u0436\u0435\u0433\u0438\u0435"
  _showSummonedMessageAlways: 1
  _bossTextColor: red
  _bossDefeatedMessage: "\u0427\u0442\u043E \u0436, \u043F\u043E\u0445\u043E\u0436\u0435,
    \u044F \u043E\u0448\u0438\u0431\u0430\u043B\u0441\u044F\u2026 \u0422\u044B \u0434\u043E\u0441\u0442\u043E\u0438\u043D
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u0438\u0446\u0443
    \u043C\u043E\u0435\u0439 \u0441\u0438\u043B\u044B"
  _bossDefeatedInteractionMessage: "\u0422\u044B \u0434\u043E\u043A\u0430\u0437\u0430\u043B
    \u0441\u0432\u043E\u044E \u0441\u0438\u043B\u0443. \u041D\u0435\u0442 \u043D\u0443\u0436\u0434\u044B
    \u043D\u0430\u043C \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F \u0432\u043D\u043E\u0432\u044C."
  _bossLostMessage: "\u041D\u0438\u0447\u0442\u043E\u0436\u043D\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0438\u0448\u043A\u0430,
    \u043D\u0435\u0443\u0436\u0435\u043B\u0438 \u0442\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C,
    \u0447\u0442\u043E \u043C\u0435\u043D\u044F \u0442\u0430\u043A \u043B\u0435\u0433\u043A\u043E
    \u043E\u0434\u043E\u043B\u0435\u0442\u044C?"
  _temporaryMessageDuration: 3
  _showBossResultMessageAlways: 1
